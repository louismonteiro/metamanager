# --- Meta Marketing API ---------------------------------------------------
# System User or User access token with `ads_management` (write) or `ads_read`
# (read-only) permission. Server-side only — never expose to the browser.
META_ACCESS_TOKEN=

# Optional. Business Manager id. When set, the ad-account listing uses
# GET /{business_id}/owned_ad_accounts instead of GET /me/adaccounts.
META_BUSINESS_ID=

# Optional. Graph API version to pin every request to. Defaults to v26.0.
# Never leave a request unversioned: unversioned calls fall back to the App
# Dashboard default and expired versions silently downgrade.
META_API_VERSION=v26.0

# Optional. Request timeout in milliseconds. Defaults to 15000.
META_API_TIMEOUT_MS=15000
