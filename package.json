{
  "name": "metamanager",
  "version": "1.0.0",
  "private": true,
  "description": "Meta Ads creation and management platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
